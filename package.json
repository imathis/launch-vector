{
  "name": "vector",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun tooling/dev.ts",
    "dev:apps": "bun run --filter './apps/*' dev",
    "dev:portless": "portless",
    "lint": "bun run --filter '*' lint",
    "format": "bun run --filter '*' format",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
